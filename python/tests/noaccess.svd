<?xml version="1.0" encoding="utf-8"?>
<!-- access declared at no level: the reader loads it, the generator refuses a pick -->
<device schemaVersion="1.3"><name>NOACC</name><addressUnitBits>8</addressUnitBits><size>32</size>
  <peripherals><peripheral><name>A</name><baseAddress>0x40000000</baseAddress>
    <registers><register><name>R</name><addressOffset>0x0</addressOffset></register></registers>
  </peripheral></peripherals></device>
