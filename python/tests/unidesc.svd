<?xml version="1.0" encoding="utf-8"?>
<!-- descriptions: one that transliterates (u, +/-), one with no ASCII form (refused at a pick) -->
<device schemaVersion="1.3"><name>UNI</name><addressUnitBits>8</addressUnitBits><size>32</size><access>read-write</access>
  <peripherals><peripheral><name>A</name><baseAddress>0x40000000</baseAddress><registers>
    <register><name>R</name><addressOffset>0x0</addressOffset><description>10 µA ±1%</description></register>
    <register><name>S</name><addressOffset>0x4</addressOffset><description>中文</description></register>
  </registers></peripheral></peripherals></device>
